{
  "name": "dsh-loadout-manager",
  "version": "1.1.0",
  "description": "Shows skills and MCP servers globally and per project, manages them, installs skills and rules from indexes, and adds rules to the agent context next to AGENTS.md.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "skills",
    "rules",
    "mcp",
    "agents"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Ivan Kalashnikov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steindvart/dsh-loadout-manager.git"
  },
  "homepage": "https://github.com/steindvart/dsh-loadout-manager#readme",
  "bugs": {
    "url": "https://github.com/steindvart/dsh-loadout-manager/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "assets/icon.svg",
    "assets/main-window.png",
    "README*.md"
  ],
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.2-rc.2 <0.3.0-0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsdown",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build --silent",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.2",
    "@deepseek-ai/dsh-agent-instructions": "0.2.2-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.2-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.2",
    "@deepseek-ai/dsh-config-editor": "0.2.2-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.2",
    "@deepseek-ai/dsh-mcp-client": "0.2.2-rc.2",
    "@deepseek-ai/dsh-mcp-manager": "0.2.2-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.2",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.2",
    "@eslint/js": "10.0.1",
    "@types/jsdom": "21.1.7",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "26.1.0",
    "lightningcss": "1.32.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tsdown": "0.22.14",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0"
  }
}
